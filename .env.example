# =============================================================================
# ai-chat-bot-server — Environment Configuration
# =============================================================================
# 复制此文件为 .env 并填入真实值:
#   cp .env.example .env
#
# 严禁将 .env 提交到版本控制！此 .env.example 是唯一的环境变量参考。
# =============================================================================

# ---------------------------------------------------------------------------
# 1. 运行环境
# ---------------------------------------------------------------------------
# 可选值: development | test | staging | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# 2. 服务器
# ---------------------------------------------------------------------------
# HTTP 监听端口
PORT=3000

# 允许的跨域来源，多个用逗号分隔
CLIENT_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# 3. 数据库 (MySQL / Prisma)
# ---------------------------------------------------------------------------
# 格式: mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://root:1234@localhost:3306/ai_chat_bot

# ---------------------------------------------------------------------------
# 4. AI / LLM (DeepSeek)
# ---------------------------------------------------------------------------
# DeepSeek API Key — 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# 模型名称
DEEPSEEK_MODEL=deepseek-v4-flash

# API 基地址（通常无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 单次请求超时时间（毫秒）
DEEPSEEK_REQUEST_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# 5. 认证 (JWT)
# ---------------------------------------------------------------------------
# JWT 签名密钥 — 生产环境请使用长度 ≥ 48 字符的随机字符串
# 生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# 存储 JWT 的 Cookie 名称
AUTH_COOKIE_NAME=ai_chat_auth

# Cookie 有效期（毫秒），默认 7 天
AUTH_COOKIE_MAX_AGE_MS=604800000

# ---------------------------------------------------------------------------
# 6. 聊天业务
# ---------------------------------------------------------------------------
# 单条消息最大字符数
CHAT_MESSAGE_MAX_LENGTH=8000

# 会话列表分页大小
CONVERSATION_LIST_LIMIT=60
